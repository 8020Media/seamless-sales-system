# Seamless Sales System 2.0 Configuration

# API Configuration
API_PORT=3000
NODE_ENV=development

# CRM Integrations
GHL_API_KEY=your_ghl_api_key_here
PIPEDRIVE_API_KEY=your_pipedrive_api_key_here
SALESFORCE_API_KEY=your_salesforce_api_key_here

# Email Configuration
SENDGRID_API_KEY=your_sendgrid_api_key_here
MAILGUN_API_KEY=your_mailgun_api_key_here

# Database (if needed)
DATABASE_URL=mongodb://localhost:27017/seamless-sales

# Logging
LOG_LEVEL=info
